// The example's settings page: LIVI's settings lists, drawn by the plugin (docs/plugins.md, "Settings"). Other
// screens (choices, numbers, colours ...) LIVI shows on its own page, because the manifest names only "list".
// The keys and a rotary knob move over LIVI's settings by themselves; the page shows where the focus is, and on the
// top screen it has an entry of its own the keys reach first (docs/plugins.md, "Keys").

import { Livi } from "@livi/api.slint";

export component Settings inherits Window {
    background: #101418;
    pure function focused(target: string) -> bool {
        return Livi.focus.zone == "page" && Livi.focus.target == target;
    }
    // the page's own entry on the top screen: declared for the page's path, the keys reach it before LIVI's rows
    property <string> page: Livi.page;
    changed page => { Livi.action("focus-targets", "/plugin/settings hello-page"); }
    property <int> press-serial: Livi.press.serial;
    changed press-serial => {
        if Livi.press.target == "hello-page" {
            root.open-hello();
        }
    }
    function open-hello() {
        Livi.action("open", "/plugin/hello");
    }
    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 16px;
            if Livi.settings.can-back: Rectangle {
                width: 96px;
                height: 48px;
                background: back.pressed ? #2a3440 : #1c242c;
                border-width: root.focused("back") ? 2px : 0px;
                border-color: #4fc3f7;
                Text { text: "Back"; color: #ffffff; }
                back := TouchArea { clicked => { Livi.action("settings", "back"); } }
            }
            Text {
                text: Livi.settings.title;
                color: #ffffff;
                font-size: 28px;
                vertical-alignment: center;
            }
        }
        if !Livi.settings.can-back: Rectangle {
            height: 56px;
            background: hello.pressed ? #1c242c : transparent;
            border-width: root.focused("hello-page") ? 2px : 0px;
            border-color: #4fc3f7;
            HorizontalLayout {
                Text {
                    text: "Hello page";
                    color: #ffffff;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            hello := TouchArea {
                clicked => { root.open-hello(); }
            }
        }
        for row[i] in Livi.setting-rows: Rectangle {
            height: 56px;
            background: touch.pressed ? #1c242c : transparent;
            border-width: root.focused("row:" + i) ? 2px : 0px;
            border-color: #4fc3f7;
            HorizontalLayout {
                Text {
                    text: row.label;
                    color: row.enabled ? #ffffff : #808890;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: row.kind == "toggle" ? (row.checked ? "on" : "off") : row.value;
                    color: #c0c8d0;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                enabled: row.enabled;
                clicked => {
                    if row.kind == "toggle" {
                        Livi.action("settings", "toggle:" + i);
                    } else if row.kind == "button" || row.kind == "pick" || row.kind == "device" {
                        Livi.action("settings", "press:" + i);
                    } else if row.kind == "route" || row.kind == "value" || row.kind == "custom" {
                        Livi.action("settings", "open:" + row.node);
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
