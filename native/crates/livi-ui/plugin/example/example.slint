// Example UI plugin for LIVI (docs/plugins.md): one page, a bar at the bottom and a page for LIVI's settings. Copy the folder to
// ~/.config/LIVI/ui-plugin (or point LIVI_UI_PLUGIN at it) and restart LIVI; check it with `LIVI --check-plugin <dir>`.

import { Livi } from "@livi/api.slint";

// LIVI reaches the state only through a global the main file exports
export { Livi }
export { Settings } from "settings.slint";

// A page: a window LIVI embeds; it reads the state from Livi
export component Hello inherits Window {
    background: #101418;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        Text {
            text: Livi.clock;
            color: #ffffff;
            font-size: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: Livi.drive.has-speed ? Math.round(Livi.drive.speed-kph) + " km/h" : "no speed yet";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            // a value LIVI has no field for, e.g. from a CAN reader that posts {"doors": "closed"}
            text: Livi.value("doors") != "" ? "doors " + Livi.value("doors") : "doors unknown";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            text: Livi.media.title != "" ? Livi.media.artist + " – " + Livi.media.title : "nothing playing";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
    }
}

// A bar: one button per page in the tab order, the shown one highlighted
export component Bar inherits Window {
    background: #000000;
    min-height: 72px;
    max-height: 72px;

    HorizontalLayout {
        alignment: center;
        spacing: 24px;
        for page in Livi.pages: Rectangle {
            width: 120px;
            border-radius: 8px;
            background: page.active ? #2a3b4c : transparent;
            Text {
                text: page.title;
                color: #ffffff;
                font-size: 18px;
            }
            TouchArea {
                clicked => { Livi.action("open", page.path); }
            }
        }
    }
}
