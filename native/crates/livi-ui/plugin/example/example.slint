// Example UI plugin for LIVI (docs/plugins.md): one page, a bar at the bottom and a page for LIVI's settings. Copy the folder to
// ~/.config/LIVI/ui-plugin (or point LIVI_UI_PLUGIN at it) and restart LIVI; check it with `LIVI --check-plugin <dir>`.

import { Livi } from "@livi/api.slint";

// LIVI reaches the state only through a global the main file exports
export { Livi }
export { Settings } from "settings.slint";

// A button the keys and a rotary knob can reach: it shows the focus while it has it (docs/plugins.md, "Keys")
component KeyButton inherits Rectangle {
    in property <string> target;
    in property <string> label;
    callback clicked;
    width: 140px;
    height: 56px;
    border-radius: 8px;
    background: touch.pressed ? #2a3440 : #1c242c;
    border-width: Livi.focus.zone == "page" && Livi.focus.target == root.target ? 3px : 0px;
    border-color: #4fc3f7;
    Text {
        text: root.label;
        color: #ffffff;
        font-size: 20px;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A page: a window LIVI embeds; it reads the state from Livi
export component Hello inherits Window {
    background: #101418;

    // what the keys move the focus over on this page, in order; from a `changed` handler, not `init`: LIVI connects
    // Livi.action only after it created the component, and sets the page right after that
    property <string> page: Livi.page;
    changed page => { Livi.action("focus-targets", "/plugin/hello play-pause next"); }
    // a button activated with a key does what a touch does
    property <int> press-serial: Livi.press.serial;
    changed press-serial => { root.pressed(Livi.press.target); }
    function pressed(target: string) {
        if target == "play-pause" {
            Livi.action("media", "play-pause");
        } else if target == "next" {
            Livi.action("media", "next");
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        Text {
            text: Livi.clock;
            color: #ffffff;
            font-size: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: Livi.drive.has-speed ? Math.round(Livi.drive.speed-kph) + " km/h" : "no speed yet";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            // a value LIVI has no field for, e.g. from a CAN reader that posts {"doors": "closed"}
            text: Livi.value("doors") != "" ? "doors " + Livi.value("doors") : "doors unknown";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            text: Livi.media.title != "" ? Livi.media.artist + " – " + Livi.media.title : "nothing playing";
            color: #9aa4ae;
            font-size: 24px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 16px;
            KeyButton {
                target: "play-pause";
                label: Livi.media.playing ? "Pause" : "Play";
                clicked => { root.pressed(self.target); }
            }
            KeyButton {
                target: "next";
                label: "Next";
                clicked => { root.pressed(self.target); }
            }
        }
        Text {
            // a key LIVI has no use for itself, e.g. an extra button of a steering wheel adapter
            text: Livi.key.code != "" ? "last other key: " + Livi.key.code : "";
            color: #9aa4ae;
            font-size: 18px;
            horizontal-alignment: center;
        }
    }
}

// A bar: one button per page in the tab order, the shown one highlighted. It lists the same tabs as LIVI's
// navigation, so it also shows where the keys' focus is there.
export component Bar inherits Window {
    background: #000000;
    min-height: 72px;
    max-height: 72px;

    HorizontalLayout {
        alignment: center;
        spacing: 24px;
        for page in Livi.pages: Rectangle {
            width: 120px;
            border-radius: 8px;
            background: page.active ? #2a3b4c : transparent;
            border-width: Livi.focus.zone == "nav" && Livi.focus.target == page.path ? 2px : 0px;
            border-color: #4fc3f7;
            Text {
                text: page.title;
                color: #ffffff;
                font-size: 18px;
            }
            TouchArea {
                clicked => { Livi.action("open", page.path); }
            }
        }
    }
}
