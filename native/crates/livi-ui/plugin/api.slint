// LIVI UI plugin API, version 1 (docs/plugins.md). Plugins import it as "@livi/api.slint".
//
// Every component LIVI shows from a plugin inherits Window (the interpreter builds only exported windows; LIVI embeds
// it into its own) and declares these two members itself:
//   in property <LiviState> livi;          the state, updated by LIVI
//   callback action(string, string);      what the user wants, as action(verb, argument):
//   action("open", path)        show a page: "/projection", "/projection/<app>" (e.g. maps, music, phone), "/media",
//                               "/telemetry", "/camera", "/settings", "/plugin/<page id>"
//   action("media", what)       "play-pause", "next" or "prev" for the phone's player
//   action("page", "next")      the next page in the tab order ("prev": the previous one), e.g. after a swipe

export struct LiviPage {
    // "/plugin/<id>" for pages of the plugin, otherwise the path of a page of LIVI
    path: string,
    title: string,
    icon: image,
    active: bool,
}

export struct LiviDate {
    year: int,
    // 1 to 12
    month: int,
    day: int,
    // 0 Sunday to 6 Saturday
    weekday: int,
}

// Texts are empty when nothing plays.
export struct LiviMedia {
    title: string,
    artist: string,
    album: string,
    app: string,
    artwork: image,
    has-artwork: bool,
    playing: bool,
    // 0 to 1
    progress: float,
    elapsed-ms: float,
    total-ms: float,
}

export struct LiviNav {
    active: bool,
    icon: image,
    maneuver: string,
    distance: string,
    road: string,
    time-left: string,
    destination: string,
    destination-distance: string,
    app: string,
}

// Vehicle telemetry; `has-*` tells whether a value has arrived at all.
export struct LiviCar {
    known: bool,
    speed-kph: float,
    has-speed: bool,
    rpm: float,
    has-rpm: bool,
    gear: string,
    ambient-c: float,
    has-ambient: bool,
    fuel-pct: float,
    has-fuel: bool,
    range-km: float,
    has-range: bool,
    odometer-km: float,
    trip-km: float,
    reverse: bool,
    lights: bool,
    high-beam: bool,
    hazards: bool,
    parking-brake: bool,
    night: bool,
}

// `known`: the values come from the car (a telemetry source); LIVI's defaults and the values saved from the last run
// keep it false. `source` names who set them ("external", "carplay", "saved", "default").
export struct LiviClimate {
    known: bool,
    source: string,
    on: bool,
    auto: bool,
    ac: bool,
    max-ac: bool,
    max-defrost: bool,
    recirculation: bool,
    synced: bool,
    driver-c: float,
    has-driver: bool,
    passenger-c: float,
    has-passenger: bool,
    fan-level: int,
    fan-auto: bool,
    front-window-heating: int,
    rear-window-heating: int,
    driver-seat-heating: int,
    passenger-seat-heating: int,
}

// A telemetry value LIVI has no field for (for example doors from a CAN reader), as text.
export struct LiviValue {
    key: string,
    value: string,
}

export struct LiviState {
    api: int,
    // path of the page on screen, e.g. "/media" or "/plugin/home"
    page: string,
    // "14:32", steady (LIVI's own clock blinks the colon)
    clock: string,
    date: LiviDate,
    dark: bool,
    // "none", "connected" or "streaming"
    phone: string,
    pages: [LiviPage],
    media: LiviMedia,
    nav: LiviNav,
    car: LiviCar,
    climate: LiviClimate,
    other: [LiviValue],
}
