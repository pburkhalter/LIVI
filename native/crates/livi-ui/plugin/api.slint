// LIVI UI plugin API, version 1 (docs/plugins.md). Plugins import it as "@livi/api.slint".
//
// LIVI's state is in the global `Livi`. Each of its properties changes on its own, so a binding only runs again when
// a property it reads has changed; a struct changes as a whole, so values that change often have structs of their own
// (`drive`, `playback`). The plugin's main file exports the global, so that LIVI can reach it:
//   export { Livi } from "@livi/api.slint";
//
// What the user wants goes to LIVI as Livi.action(verb, argument):
//   Livi.action("open", path)    show a page: "/projection", "/projection/<app>" (e.g. maps, music, mobilephone), "/media",
//                                "/telemetry", "/camera", "/settings", "/plugin/<page id>"
//   Livi.action("media", what)   "play-pause", "next" or "prev" for the phone's player
//   Livi.action("page", "next")  the plugin's next page in the tab order ("prev": the previous one), e.g. after a
//                                swipe; nothing at the first or last one
//   Livi.action("notice", "dismiss:<id>")  close a notice (LiviNotice)
//   Livi.action("settings", w)   on the plugin's settings page (LiviSettings below): "open:<node>", "toggle:<row>",
//                                "press:<row>", "capture:<row>", "slide:<node>:<level>", "slide-done:<node>:<level>",
//                                "pick:<index>", "number:<value>", "level:<level>", "level-done:<level>",
//                                "text:<text>", "hex:<rrggbb>", "color-slide:<0 hue|1 sat.|2 light.>:<level>",
//                                "color-slide-done:<i>:<level>", "color-reset", "knob:<i>:<level>",
//                                "knob-done:<i>:<level>", "knob-reset:<i>", "dialog-press:<row>", "capture-cancel",
//                                "back", "apply"
//
// Every component LIVI shows from a plugin inherits Window: the interpreter builds only exported windows, and LIVI
// embeds them into its own.

export struct LiviPage {
    // "/plugin/<id>" for pages of the plugin, otherwise the path of a page of LIVI
    path: string,
    title: string,
    icon: image,
    active: bool,
}

export struct LiviDate {
    year: int,
    // 1 to 12
    month: int,
    day: int,
    // 0 Sunday to 6 Saturday
    weekday: int,
}

// Texts are empty when nothing plays.
export struct LiviMedia {
    title: string,
    artist: string,
    album: string,
    app: string,
    artwork: image,
    has-artwork: bool,
    playing: bool,
    total-ms: float,
}

// Where the song is; changes every second while it plays.
export struct LiviPlayback {
    // 0 to 1
    progress: float,
    elapsed-ms: float,
}

export struct LiviNav {
    active: bool,
    icon: image,
    maneuver: string,
    distance: string,
    road: string,
    time-left: string,
    destination: string,
    destination-distance: string,
    app: string,
}

// What changes many times a second while driving; `has-*` tells whether a value has arrived at all.
export struct LiviDrive {
    speed-kph: float,
    has-speed: bool,
    rpm: float,
    has-rpm: bool,
    gear: string,
}

// The other vehicle telemetry; `known`: any telemetry has arrived.
export struct LiviCar {
    known: bool,
    // the speed is above 0
    moving: bool,
    ambient-c: float,
    has-ambient: bool,
    fuel-pct: float,
    has-fuel: bool,
    range-km: float,
    has-range: bool,
    odometer-km: float,
    trip-km: float,
    reverse: bool,
    lights: bool,
    high-beam: bool,
    hazards: bool,
    parking-brake: bool,
    night: bool,
}

// `known`: the values come from the car (a telemetry source); LIVI's defaults and the values saved from the last run
// keep it false. `source` names who set them ("external", "carplay", "saved", "default").
export struct LiviClimate {
    known: bool,
    source: string,
    on: bool,
    auto: bool,
    ac: bool,
    max-ac: bool,
    max-defrost: bool,
    recirculation: bool,
    synced: bool,
    driver-c: float,
    has-driver: bool,
    passenger-c: float,
    has-passenger: bool,
    fan-level: int,
    fan-auto: bool,
    front-window-heating: int,
    rear-window-heating: int,
    driver-seat-heating: int,
    passenger-seat-heating: int,
}

// LIVI's settings, the screen on top of its settings stack, while the plugin's settings page is on screen (a page with
// "settings" in the manifest, which names the kinds it draws; LIVI shows the other ones on its own settings page and
// hands them back). `kind`: "list", "select", "number", "text", "color", "slider", "calibration" or "pending"; a
// dialog over the screen and the wait for a key count as "dialog" and "capture".
export struct LiviSettings {
    kind: string,
    title: string,
    can-back: bool,
    show-apply: bool,
    apply-text: string,
    read-only: bool,
    // number: the value, how LIVI writes it, its bounds and step
    number-value: float,
    number-text: string,
    number-min: float,
    number-max: float,
    has-min: bool,
    has-max: bool,
    number-step: float,
    // slider: 0 to 1
    level: float,
    level-text: string,
    // pending: what waits for a restart
    pending-name: string,
    // text
    text-value: string,
    text-max: int,
    // color: the colour, as hex, whether it is the user's own, and its hue, saturation and lightness (0 to 1) with
    // the colours for the rails of their sliders
    color-preview: color,
    color-hex: string,
    color-custom: bool,
    hue: float,
    saturation: float,
    lightness: float,
    saturation-from: color,
    saturation-to: color,
    lightness-mid: color,
    hue-label: string,
    saturation-label: string,
    lightness-label: string,
    // calibration: a grey wedge instead of the colour swatches; the sliders are `setting-knobs`
    wedge: bool,
    // a dialog over the screen: its title, its rows are `setting-dialog-rows` ("dialog-press:<row>")
    dialog-open: bool,
    dialog-title: string,
    // waiting for a key ("capture-cancel" stops it)
    capture-open: bool,
    capture-title: string,
    capture-hint: string,
}

// A slider of a calibration screen ("knob:<index>:<level>", "knob-reset:<index>" unless it is `neutral`)
export struct LiviKnob {
    text: string,
    icon: image,
    has-icon: bool,
    tint: color,
    has-tint: bool,
    level: float,
    neutral: bool,
}

// A row of a settings list. `kind`: "route" and "value" open a screen ("open:<node>"), "toggle" switches
// ("toggle:<row>"), "slider" slides ("slide:<node>:<level>"), "button", "device" and "pick" are pressed
// ("press:<row>"), "custom" opens as well, "key-binding" waits for a key ("capture:<row>", shown by LIVI's page);
// "info", "progress", "picture", "item" and "devices" only show. <row> is the row's position in `setting-rows`.
export struct LiviSettingRow {
    kind: string,
    label: string,
    icon: image,
    has-icon: bool,
    value: string,
    checked: bool,
    // slider and progress: 0 to 1
    level: float,
    enabled: bool,
    dimmed: bool,
    alert: bool,
    // the text of a button
    button: string,
    node: int,
}

// A choice of a select screen ("pick:<index>")
export struct LiviPick {
    label: string,
    selected: bool,
}

// A notification another program sent (org.freedesktop.Notifications, e.g. notify-send), newest first in `notices`.
// `urgency`: "low", "normal" or "critical". The local time it came: `today`, `hour`, `minute`, `day`, `month`.
export struct LiviNotice {
    id: int,
    app: string,
    summary: string,
    body: string,
    urgency: string,
    today: bool,
    hour: int,
    minute: int,
    day: int,
    month: int,
}

// A telemetry value LIVI has no field for (for example doors from a CAN reader), as text.
export struct LiviValue {
    key: string,
    value: string,
}

export global Livi {
    // path of the page on screen, e.g. "/media" or "/plugin/home"
    in property <string> page;
    // "14:32", steady (LIVI's own clock blinks the colon)
    in property <string> clock;
    in property <LiviDate> date;
    in property <bool> dark;
    // "none", "connected" or "streaming"
    in property <string> phone;
    // LIVI's and the plugin's pages in tab order
    in property <[LiviPage]> pages;
    in property <LiviMedia> media;
    in property <LiviPlayback> playback;
    in property <LiviNav> nav;
    in property <LiviDrive> drive;
    in property <LiviCar> car;
    in property <LiviClimate> climate;
    in property <[LiviValue]> other;
    // what a CAN reader keeps under the telemetry key `can`: raw values that may change many times a second, apart
    // from `other`
    in property <[LiviValue]> can;
    in property <[LiviNotice]> notices;
    in property <LiviSettings> settings;
    in property <[LiviSettingRow]> setting-rows;
    in property <[LiviPick]> setting-picks;
    in property <[LiviKnob]> setting-knobs;
    in property <[LiviSettingRow]> setting-dialog-rows;
    callback action(verb: string, argument: string);

    // The value of a key in `other`, "" when there is none, e.g. Livi.value("doors")
    public pure function value(key: string) -> string {
        // reading `other` here makes a binding run again when it changes
        return self.find(self.other, key);
    }
    // LIVI looks the key up for value()
    pure callback find(values: [LiviValue], key: string) -> string;
}
