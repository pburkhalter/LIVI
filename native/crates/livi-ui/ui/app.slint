import "fonts/Roboto-300.ttf";
import "fonts/Roboto-400.ttf";
import "fonts/Roboto-500.ttf";
import "fonts/Roboto-700.ttf";
import { Theme, Ui } from "theme.slint";
import { Focus, FocusZone } from "focus.slint";
import { Nav, Page, PhoneState, TabData } from "nav.slint";
import { MediaPage, MediaText, Press, DabState, StationData } from "media.slint";
import { ProjectionPage, TouchPhase } from "projection.slint";
import { SettingsView, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData } from "settings/view.slint";
import { Dashboard, DashState, GaugeData, CapData, TrailData, LabelData } from "dashboard.slint";
import { LevelOverlay, PhoneOverlay, OverlayState } from "overlays.slint";
import { MaskData } from "mask.slint";

export { Theme, Focus, FocusZone, Page, PhoneState, TabData, TouchPhase, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData, MediaText, Press, DabState, StationData, DashState, GaugeData, CapData, TrailData, LabelData, OverlayState, MaskData }

// Whether the phone's picture shows as a card in the free area of a plugin with bars, and the card: distances from
// the edges of the phone's picture and corner radius, in its pixels (settings projectionCard, videoCard*, like the
// view area; all 0 without a card); Android Auto stays full screen
export struct VideoCardData {
    projection: bool,
    android: bool,
    top: int,
    bottom: int,
    left: int,
    right: int,
    radius: int,
}

// A page of the UI plugin, as the window shows it
export struct PluginView {
    id: string,
    factory: component-factory,
}

export component AppWindow inherits Window {
    in-out property <Page> page: Page.media;
    in property <[TabData]> tabs;
    in property <image> projection-icon;
    in property <PhoneState> phone;
    in property <string> clock;
    in property <bool> right-hand;
    in property <int> stream-width: 1280;
    in property <int> stream-height: 720;
    in property <MaskData> main-mask;
    in property <bool> camera-found;
    in property <string> status;
    in property <VideoCardData> video-card;

    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;

    // UI plugin (docs/plugins.md): the page shown for Page.plugin and the bars that may replace the navigation
    in-out property <string> plugin-page-id;
    // the plugin's pages: all stay alive, the one on screen is visible, so switching to one is only drawing it
    in property <[PluginView]> plugin-pages;
    in property <component-factory> plugin-start;
    in property <component-factory> plugin-end;
    in property <component-factory> plugin-top;
    in property <component-factory> plugin-bottom;
    in property <component-factory> plugin-background;
    in property <bool> has-plugin-background;
    in property <component-factory> plugin-overlay;
    in property <bool> has-plugin-overlay;
    // what the plugin shows on LIVI's pages while they have nothing to show: no phone streaming, no camera
    in property <component-factory> plugin-no-phone;
    in property <bool> has-plugin-no-phone;
    in property <component-factory> plugin-no-camera;
    in property <bool> has-plugin-no-camera;
    // the plugin wants the page on screen without its bars (e.g. a camera picture)
    in property <bool> plugin-bars-hidden;
    in property <bool> has-plugin-start;
    in property <bool> has-plugin-end;
    in property <bool> has-plugin-top;
    in property <bool> has-plugin-bottom;

    // Start: a plugin's start picture covers the window until the UI has its content, then fades out, so the boot
    // splash goes over into LIVI without a hard cut (false while it covers, set by plugins/mod.rs)
    in property <image> intro-image;
    in property <bool> intro-done: true;
    // debug overlay (setting "debugOverlay"): frame rate, load, memory
    in property <bool> debug-shown;
    in property <string> debug-text;

    callback page-chosen(Page);
    callback touch(TouchPhase, float, float);
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);
    // the button on the phone's picture: card (true) or full screen
    callback video-card-chosen(bool);

    // the page shows a picture of the phone or the camera: the compositor draws it below this window and shows it where
    // the window is transparent, so a plugin's background leaves it uncovered
    property <bool> video-shown: (root.page == Page.projection && root.phone == PhoneState.streaming)
        || (root.page == Page.camera && root.camera-found);
    // ... or, with a card set, draws around the phone's picture as a card and keeps the bars (the phone draws in the
    // card: the core gives it the card as its view area, the same card as here); a button switches between card and
    // full screen. The camera picture stays full screen below the window for now.
    property <bool> card-set: !root.video-card.android
        && root.video-card.top + root.video-card.bottom + root.video-card.left + root.video-card.right > 0;
    // the card in the window: the phone's picture fills the window as far as its shape allows (as the compositor
    // shows it), the card's pixels scale with it
    property <float> picture-scale: min(root.width / 1px / max(1, root.stream-width),
        root.height / 1px / max(1, root.stream-height));
    property <length> picture-x: (root.width - root.stream-width * 1px * root.picture-scale) / 2;
    property <length> picture-y: (root.height - root.stream-height * 1px * root.picture-scale) / 2;
    out property <length> card-top: root.picture-y + root.video-card.top * 1px * root.picture-scale;
    out property <length> card-bottom: root.picture-y + root.video-card.bottom * 1px * root.picture-scale;
    out property <length> card-left: root.picture-x + root.video-card.left * 1px * root.picture-scale;
    out property <length> card-right: root.picture-x + root.video-card.right * 1px * root.picture-scale;
    out property <length> card-radius: root.video-card.radius * 1px * root.picture-scale;
    out property <bool> video-card-shown: root.video-shown && root.card-set && root.page == Page.projection
        && root.video-card.projection;
    property <bool> nav-hidden: root.page == Page.projection && root.phone == PhoneState.streaming
        && !root.video-card-shown;
    property <bool> nav-asleep;
    // a plugin bar at the side takes the place of LIVI's navigation
    property <bool> own-nav: !root.has-plugin-start && !root.has-plugin-end;
    property <bool> bars-shown: !root.nav-hidden && !root.plugin-bars-hidden;
    // where the button is, for touches the phone must not get (touch_ui.rs)
    out property <bool> video-button-shown: root.page == Page.projection && root.phone == PhoneState.streaming
        && root.card-set;
    out property <length> video-button-size: 72px;
    out property <length> video-button-x: root.video-card-shown
        ? root.width - root.card-right - 20px - self.video-button-size : 20px;
    out property <length> video-button-y: root.video-card-shown ? root.card-top + 20px : 20px;

    public function wake-nav() {
        root.nav-asleep = false;
        DashState.dots-shown = true;
        if (root.page == Page.telemetry) {
            nav-timer.start();
            nav-timer.restart();
        } else {
            nav-timer.stop();
        }
    }

    nav-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.stop();
            root.nav-asleep = true;
            DashState.dots-shown = false;
        }
    }
    changed page => {
        root.wake-nav();
    }

    title: "LIVI";
    default-font-family: "Roboto";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 200px;
    background: transparent;

    changed height => { Ui.height = self.height; }
    changed width => { Ui.width = self.width; }
    init => {
        Ui.height = self.height;
        Ui.width = self.width;
        root.wake-nav();
    }

    if root.has-plugin-background && (!root.video-shown || root.video-card-shown): ComponentContainer {
        width: root.width;
        height: root.height;
        component-factory: root.plugin-background;
    }
    // Around the card the window is never fully transparent, even where a bar has a gap: the compositor gives a touch
    // on a transparent pixel straight to the phone (alpha 1 of 255 is invisible)
    if root.video-card-shown: Rectangle {
        height: root.card-top;
        background: #00000001;
    }
    if root.video-card-shown: Rectangle {
        y: root.height - root.card-bottom;
        height: root.card-bottom;
        background: #00000001;
    }
    if root.video-card-shown: Rectangle {
        y: root.card-top;
        width: root.card-left;
        height: root.height - root.card-top - root.card-bottom;
        background: #00000001;
    }
    if root.video-card-shown: Rectangle {
        x: root.width - root.card-right;
        y: root.card-top;
        width: root.card-right;
        height: root.height - root.card-top - root.card-bottom;
        background: #00000001;
    }

    // the phone's picture as a card: the page takes the whole window below the bars, touches count in the card
    if root.video-card-shown && root.page == Page.projection: ProjectionPage {
        width: root.width;
        height: root.height;
        streaming: true;
        stream-width: root.stream-width;
        stream-height: root.stream-height;
        mask: root.main-mask;
        area-top: root.card-top;
        area-bottom: root.card-bottom;
        area-left: root.card-left;
        area-right: root.card-right;
        touch(phase, x, y) => { root.touch(phase, x, y); }
    }

    // with LIVI's own navigation the dashboard takes the whole window (the navigation goes to sleep over it); next to a
    // plugin's bar it takes the page's place like the other pages, below
    if root.page == Page.telemetry && root.own-nav: Dashboard {
        width: root.width;
        height: root.height;
    }

    VerticalLayout {
      if root.has-plugin-top && root.bars-shown: ComponentContainer {
        component-factory: root.plugin-top;
      }
      HorizontalLayout {
        vertical-stretch: 1;
        if !root.right-hand && !root.nav-hidden && root.own-nav: Nav {
            tabs: root.tabs;
            active: root.page;
            active-plugin: root.plugin-page-id;
            phone: root.phone;
            clock: root.clock;
            right-hand: false;
            asleep: root.nav-asleep;
            select(p, id) => {
                root.plugin-page-id = id;
                root.page = p;
                root.page-chosen(p);
            }
        }
        if root.has-plugin-start && root.bars-shown: ComponentContainer {
            component-factory: root.plugin-start;
        }
        Rectangle {
            horizontal-stretch: 1;
            for view in root.plugin-pages: ComponentContainer {
                visible: root.page == Page.plugin && view.id == root.plugin-page-id;
                width: parent.width;
                height: parent.height;
                component-factory: view.factory;
            }
            if root.page == Page.telemetry && !root.own-nav: Dashboard {
                width: parent.width;
                height: parent.height;
            }
            if root.page == Page.projection && root.has-plugin-no-phone && root.phone != PhoneState.streaming: ComponentContainer {
                width: parent.width;
                height: parent.height;
                component-factory: root.plugin-no-phone;
            }
            if root.page == Page.projection && !root.video-card-shown
                && !(root.has-plugin-no-phone && root.phone != PhoneState.streaming): ProjectionPage {
                width: parent.width;
                height: parent.height;
                streaming: root.phone == PhoneState.streaming;
                idle-icon: root.projection-icon;
                stream-width: root.stream-width;
                stream-height: root.stream-height;
                mask: root.main-mask;
                touch(phase, x, y) => { root.touch(phase, x, y); }
            }
            if root.page == Page.media: MediaPage {
                width: parent.width;
                height: parent.height;
                track-title: root.track-title;
                artist: root.artist;
                album: root.album;
                app: root.app;
                artwork: root.artwork;
                has-artwork: root.has-artwork;
                playing: root.playing;
                progress: root.progress;
                elapsed-ms: root.elapsed-ms;
                total-ms: root.total-ms;
                can-seek: root.can-seek;
                show-spectrum <=> root.show-spectrum;
                bands: root.bands;
                play-pause => { root.play-pause(); }
                prev => { root.prev(); }
                next => { root.next(); }
                seek(f) => { root.seek(f); }
                spectrum-changed(on) => { root.spectrum-changed(on); }
            }
            if root.page == Page.settings: SettingsView {
                width: parent.width;
                height: parent.height;
            }
            if root.page == Page.camera && !root.camera-found && root.has-plugin-no-camera: ComponentContainer {
                width: parent.width;
                height: parent.height;
                component-factory: root.plugin-no-camera;
            }
            if root.page == Page.camera && !root.camera-found && !root.has-plugin-no-camera: Rectangle {
                background: Theme.background;
                Text {
                    text: "No camera found";
                    color: Theme.text-secondary;
                    font-size: 20px;
                }
            }
            if root.status != "": Text {
                x: 16px;
                y: parent.height - 32px;
                text: root.status;
                color: #ff8a80;
                font-size: 14px;
            }
        }
        if root.has-plugin-end && root.bars-shown: ComponentContainer {
            component-factory: root.plugin-end;
        }
        if root.right-hand && !root.nav-hidden && root.own-nav: Nav {
            tabs: root.tabs;
            active: root.page;
            active-plugin: root.plugin-page-id;
            phone: root.phone;
            clock: root.clock;
            right-hand: true;
            asleep: root.nav-asleep;
            select(p, id) => {
                root.plugin-page-id = id;
                root.page = p;
                root.page-chosen(p);
            }
        }
      }
      if root.has-plugin-bottom && root.bars-shown: ComponentContainer {
        component-factory: root.plugin-bottom;
      }
    }

    // above the pages and bars, also on full screen pages and over the projection; touches go through it except
    // where the plugin has a TouchArea
    if root.has-plugin-overlay: ComponentContainer {
        width: root.width;
        height: root.height;
        component-factory: root.plugin-overlay;
    }

    if root.video-button-shown: Rectangle {
        x: root.video-button-x;
        y: root.video-button-y;
        width: root.video-button-size;
        height: root.video-button-size;
        border-radius: self.height / 2;
        background: video-touch.pressed ? #000000d9 : #0000008c;
        border-width: 1px;
        border-color: #ffffff38;
        Path {
            width: 36px;
            height: 36px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #ffffff;
            // Material "fullscreen" and "fullscreen exit"
            commands: root.video-card-shown
                ? "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
                : "M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z";
        }
        video-touch := TouchArea {
            clicked => { root.video-card-chosen(!root.video-card-shown); }
        }
    }

    LevelOverlay {
        window-width: root.width;
        x: (root.width - self.width) / 2;
        y: 16px;
    }
    PhoneOverlay {
        window-width: root.width;
        x: root.width - self.width - 16px;
        y: 16px;
    }

    if root.debug-shown: Rectangle {
        x: root.width - self.width - 12px;
        y: 12px;
        width: debug-label.preferred-width + 24px;
        height: debug-label.preferred-height + 16px;
        border-radius: 8px;
        background: #000000b8;
        debug-label := Text {
            text: root.debug-text;
            color: #ffffff;
            font-size: 18px;
        }
    }

    Rectangle {
        background: #000000;
        opacity: root.intro-done ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.intro-image;
            image-fit: contain;
        }
    }
}

export component SecondaryWindow inherits Window {
    in property <bool> has-dashboard;
    in property <string> window-title;
    title: root.window-title;
    in property <string> empty-label: "No content on this screen";
    default-font-family: "Roboto";
    background: root.has-dashboard ? transparent : #000000;

    if root.has-dashboard: Dashboard {
        width: root.width;
        height: root.height;
    }
    if !root.has-dashboard: Text {
        text: root.empty-label;
        color: #ffffff73;
        font-size: 20px;
    }
}
