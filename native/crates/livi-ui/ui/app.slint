import "fonts/Roboto-300.ttf";
import "fonts/Roboto-400.ttf";
import "fonts/Roboto-500.ttf";
import "fonts/Roboto-700.ttf";
import { Theme, Ui } from "theme.slint";
import { Focus, FocusZone } from "focus.slint";
import { Nav, Page, PhoneState, TabData } from "nav.slint";
import { MediaPage, MediaText, Press, DabState, StationData } from "media.slint";
import { ProjectionPage, TouchPhase } from "projection.slint";
import { SettingsView, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData } from "settings/view.slint";
import { Dashboard, DashState, GaugeData, CapData, TrailData, LabelData } from "dashboard.slint";
import { LevelOverlay, PhoneOverlay, OverlayState } from "overlays.slint";
import { MaskData } from "mask.slint";

export { Theme, Focus, FocusZone, Page, PhoneState, TabData, TouchPhase, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData, MediaText, Press, DabState, StationData, DashState, GaugeData, CapData, TrailData, LabelData, OverlayState, MaskData }

// A page of the UI plugin, as the window shows it
export struct PluginView {
    id: string,
    factory: component-factory,
}

export component AppWindow inherits Window {
    in-out property <Page> page: Page.media;
    in property <[TabData]> tabs;
    in property <image> projection-icon;
    in property <PhoneState> phone;
    in property <string> clock;
    in property <bool> right-hand;
    in property <int> stream-width: 1280;
    in property <int> stream-height: 720;
    in property <MaskData> main-mask;
    in property <bool> camera-found;
    in property <string> status;

    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;

    // UI plugin (docs/plugins.md): the page shown for Page.plugin and the bars that may replace the navigation
    in-out property <string> plugin-page-id;
    // the plugin's pages: all stay alive, the one on screen is visible, so switching to one is only drawing it
    in property <[PluginView]> plugin-pages;
    in property <component-factory> plugin-start;
    in property <component-factory> plugin-end;
    in property <component-factory> plugin-top;
    in property <component-factory> plugin-bottom;
    in property <component-factory> plugin-background;
    in property <bool> has-plugin-background;
    in property <component-factory> plugin-overlay;
    in property <bool> has-plugin-overlay;
    // what the plugin shows on LIVI's pages while they have nothing to show: no phone streaming, no camera
    in property <component-factory> plugin-no-phone;
    in property <bool> has-plugin-no-phone;
    in property <component-factory> plugin-no-camera;
    in property <bool> has-plugin-no-camera;
    // the plugin wants the page on screen without its bars (e.g. a camera picture)
    in property <bool> plugin-bars-hidden;
    in property <bool> has-plugin-start;
    in property <bool> has-plugin-end;
    in property <bool> has-plugin-top;
    in property <bool> has-plugin-bottom;

    // Start: a plugin's start picture covers the window until the UI has its content, then fades out, so the boot
    // splash goes over into LIVI without a hard cut (false while it covers, set by plugins/mod.rs)
    in property <image> intro-image;
    in property <bool> intro-done: true;

    callback page-chosen(Page);
    callback touch(TouchPhase, float, float);
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    property <bool> nav-hidden: root.page == Page.projection && root.phone == PhoneState.streaming;
    property <bool> nav-asleep;
    // a plugin bar at the side takes the place of LIVI's navigation
    property <bool> own-nav: !root.has-plugin-start && !root.has-plugin-end;
    property <bool> bars-shown: !root.nav-hidden && !root.plugin-bars-hidden;

    public function wake-nav() {
        root.nav-asleep = false;
        DashState.dots-shown = true;
        if (root.page == Page.telemetry) {
            nav-timer.start();
            nav-timer.restart();
        } else {
            nav-timer.stop();
        }
    }

    nav-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.stop();
            root.nav-asleep = true;
            DashState.dots-shown = false;
        }
    }
    changed page => {
        root.wake-nav();
    }

    title: "LIVI";
    default-font-family: "Roboto";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 200px;
    background: transparent;

    changed height => { Ui.height = self.height; }
    changed width => { Ui.width = self.width; }
    init => {
        Ui.height = self.height;
        Ui.width = self.width;
        root.wake-nav();
    }

    if root.has-plugin-background: ComponentContainer {
        width: root.width;
        height: root.height;
        component-factory: root.plugin-background;
    }

    // with LIVI's own navigation the dashboard takes the whole window (the navigation goes to sleep over it); next to a
    // plugin's bar it takes the page's place like the other pages, below
    if root.page == Page.telemetry && root.own-nav: Dashboard {
        width: root.width;
        height: root.height;
    }

    VerticalLayout {
      if root.has-plugin-top && root.bars-shown: ComponentContainer {
        component-factory: root.plugin-top;
      }
      HorizontalLayout {
        vertical-stretch: 1;
        if !root.right-hand && !root.nav-hidden && root.own-nav: Nav {
            tabs: root.tabs;
            active: root.page;
            active-plugin: root.plugin-page-id;
            phone: root.phone;
            clock: root.clock;
            right-hand: false;
            asleep: root.nav-asleep;
            select(p, id) => {
                root.plugin-page-id = id;
                root.page = p;
                root.page-chosen(p);
            }
        }
        if root.has-plugin-start && root.bars-shown: ComponentContainer {
            component-factory: root.plugin-start;
        }
        Rectangle {
            horizontal-stretch: 1;
            for view in root.plugin-pages: ComponentContainer {
                visible: root.page == Page.plugin && view.id == root.plugin-page-id;
                width: parent.width;
                height: parent.height;
                component-factory: view.factory;
            }
            if root.page == Page.telemetry && !root.own-nav: Dashboard {
                width: parent.width;
                height: parent.height;
            }
            if root.page == Page.projection && root.has-plugin-no-phone && root.phone != PhoneState.streaming: ComponentContainer {
                width: parent.width;
                height: parent.height;
                component-factory: root.plugin-no-phone;
            }
            if root.page == Page.projection && !(root.has-plugin-no-phone && root.phone != PhoneState.streaming): ProjectionPage {
                width: parent.width;
                height: parent.height;
                streaming: root.phone == PhoneState.streaming;
                idle-icon: root.projection-icon;
                stream-width: root.stream-width;
                stream-height: root.stream-height;
                mask: root.main-mask;
                touch(phase, x, y) => { root.touch(phase, x, y); }
            }
            if root.page == Page.media: MediaPage {
                width: parent.width;
                height: parent.height;
                track-title: root.track-title;
                artist: root.artist;
                album: root.album;
                app: root.app;
                artwork: root.artwork;
                has-artwork: root.has-artwork;
                playing: root.playing;
                progress: root.progress;
                elapsed-ms: root.elapsed-ms;
                total-ms: root.total-ms;
                can-seek: root.can-seek;
                show-spectrum <=> root.show-spectrum;
                bands: root.bands;
                play-pause => { root.play-pause(); }
                prev => { root.prev(); }
                next => { root.next(); }
                seek(f) => { root.seek(f); }
                spectrum-changed(on) => { root.spectrum-changed(on); }
            }
            if root.page == Page.settings: SettingsView {
                width: parent.width;
                height: parent.height;
            }
            if root.page == Page.camera && !root.camera-found && root.has-plugin-no-camera: ComponentContainer {
                width: parent.width;
                height: parent.height;
                component-factory: root.plugin-no-camera;
            }
            if root.page == Page.camera && !root.camera-found && !root.has-plugin-no-camera: Rectangle {
                background: Theme.background;
                Text {
                    text: "No camera found";
                    color: Theme.text-secondary;
                    font-size: 20px;
                }
            }
            if root.status != "": Text {
                x: 16px;
                y: parent.height - 32px;
                text: root.status;
                color: #ff8a80;
                font-size: 14px;
            }
        }
        if root.has-plugin-end && root.bars-shown: ComponentContainer {
            component-factory: root.plugin-end;
        }
        if root.right-hand && !root.nav-hidden && root.own-nav: Nav {
            tabs: root.tabs;
            active: root.page;
            active-plugin: root.plugin-page-id;
            phone: root.phone;
            clock: root.clock;
            right-hand: true;
            asleep: root.nav-asleep;
            select(p, id) => {
                root.plugin-page-id = id;
                root.page = p;
                root.page-chosen(p);
            }
        }
      }
      if root.has-plugin-bottom && root.bars-shown: ComponentContainer {
        component-factory: root.plugin-bottom;
      }
    }

    // above the pages and bars, also on full screen pages and over the projection; touches go through it except
    // where the plugin has a TouchArea
    if root.has-plugin-overlay: ComponentContainer {
        width: root.width;
        height: root.height;
        component-factory: root.plugin-overlay;
    }

    LevelOverlay {
        window-width: root.width;
        x: (root.width - self.width) / 2;
        y: 16px;
    }
    PhoneOverlay {
        window-width: root.width;
        x: root.width - self.width - 16px;
        y: 16px;
    }

    Rectangle {
        background: #000000;
        opacity: root.intro-done ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.intro-image;
            image-fit: contain;
        }
    }
}

export component SecondaryWindow inherits Window {
    in property <bool> has-dashboard;
    in property <string> window-title;
    title: root.window-title;
    in property <string> empty-label: "No content on this screen";
    default-font-family: "Roboto";
    background: root.has-dashboard ? transparent : #000000;

    if root.has-dashboard: Dashboard {
        width: root.width;
        height: root.height;
    }
    if !root.has-dashboard: Text {
        text: root.empty-label;
        color: #ffffff73;
        font-size: 20px;
    }
}
